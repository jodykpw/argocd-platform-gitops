    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Memory and CPU",
   "description": "CPU is shown in nano-cores on the same axis: look at the trend, not the value.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 20
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otelcol_process_memory_rss{job=\"jaeger\"}",
     "legendFormat": "memory RSS",
     "refId": "A",
     "editorMode": "code"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(otelcol_process_cpu_seconds{job=\"jaeger\"}[5m]) * 1000000000",
     "legendFormat": "cpu (scaled, 1e9 = 1 core)",
     "refId": "B",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 12,
   "type": "table",
   "title": "Recent traces for $service",
   "description": "Jaeger search through the Jaeger data source. Pick the service above; add new service names to the variable list in dashboards.yaml.",
   "datasource": {
    "type": "jaeger",
    "uid": "jaeger"
   },
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 28
   },
   "targets": [
    {
     "datasource": {
      "type": "jaeger",
      "uid": "jaeger"
     },
     "queryType": "search",
     "service": "$service",
     "operation": "",
     "limit": 20,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "duration"
      },
      "properties": [
       {
        "id": "unit",
        "value": "µs"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "startTime",
      "desc": true
     }
    ]
   }
  }
 ],
