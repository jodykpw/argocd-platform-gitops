{
 "uid": "platform-jaeger",
 "title": "Jaeger (k8s-1)",
 "tags": [
  "platform",
  "jaeger",
  "tracing"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Jaeger up",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min(up{job=\"jaeger\"})",
     "legendFormat": "",
     "refId": "A",
     "editorMode": "code",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Spans received (since start)",
   "description": "Counter since the pod started.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 4,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(otelcol_receiver_accepted_spans{job=\"jaeger\"})",
     "legendFormat": "",
     "refId": "A",
     "editorMode": "code",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Spans refused or failed",
   "description": "Should stay 0. Refused usually means the processing queue is full.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 9,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(otelcol_receiver_refused_spans{job=\"jaeger\"}) + sum(otelcol_receiver_failed_spans{job=\"jaeger\"})",
     "legendFormat": "",
     "refId": "A",
     "editorMode": "code",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Storage free (Badger volume)",
   "description": "Free space on the 5 GiB volume. The Badger value-log size metric is a preallocated sparse file (about 2 GiB), not data actually used.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 14,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "jaeger_storage_badger_value_log_bytes_available{job=\"jaeger\"}",
     "legendFormat": "",
     "refId": "A",
     "editorMode": "code",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 1000000000
       },
       {
        "color": "green",
        "value": 2000000000
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Memory (RSS)",
   "description": "Limit is 512Mi.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 19,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "otelcol_process_memory_rss{job=\"jaeger\"}",
     "legendFormat": "",
     "refId": "A",
     "editorMode": "code",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 350000000
       },
       {
        "color": "red",
        "value": 450000000
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Spans received per second",
   "description": "OTLP gRPC (4317) and HTTP (4318). Traefik uses gRPC.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (transport) (rate(otelcol_receiver_accepted_spans{job=\"jaeger\"}[5m]))",
     "legendFormat": "accepted {{transport}}",
     "refId": "A",
     "editorMode": "code"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(otelcol_receiver_refused_spans{job=\"jaeger\"}[5m]))",
     "legendFormat": "refused",
     "refId": "B",
     "editorMode": "code"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(otelcol_receiver_failed_spans{job=\"jaeger\"}[5m]))",
     "legendFormat": "failed",
     "refId": "C",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Spans written to storage per second",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(otelcol_exporter_sent_spans{job=\"jaeger\"}[5m]))",
     "legendFormat": "stored",
     "refId": "A",
     "editorMode": "code"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(otelcol_exporter_send_failed_spans{job=\"jaeger\"}[5m])) or vector(0)",
     "legendFormat": "failed",
     "refId": "B",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Storage latency (p50, p95, p99)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(jaeger_storage_latency_bucket{job=\"jaeger\"}[5m])))",
     "legendFormat": "p50",
     "refId": "A",
     "editorMode": "code"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(jaeger_storage_latency_bucket{job=\"jaeger\"}[5m])))",
     "legendFormat": "p95",
     "refId": "B",
     "editorMode": "code"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(jaeger_storage_latency_bucket{job=\"jaeger\"}[5m])))",
     "legendFormat": "p99",
     "refId": "C",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Storage requests per second",
   "description": "Reads from Grafana and writes from the pipeline. result=err on get_trace is a lookup of a trace that does not exist.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (operation, result) (rate(jaeger_storage_requests{job=\"jaeger\"}[5m]))",
     "legendFormat": "{{operation}} {{result}}",
     "refId": "A",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Badger size and free space",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 20
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "jaeger_storage_badger_size_bytes_lsm{job=\"jaeger\"}",
