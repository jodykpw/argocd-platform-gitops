        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Age of last good backup",
   "description": "Orange after 36 h, red after 60 h. No data until the first scheduled run.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "time() - max(velero_backup_last_successful_timestamp{schedule=\"velero-daily\"})",
     "legendFormat": "",
     "refId": "A",
     "editorMode": "code",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 129600
       },
       {
        "color": "red",
        "value": 216000
       }
      ]
     }
    },
    "overrides": []
   }
  },
