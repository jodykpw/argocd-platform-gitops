    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min(velero_backup_location_status_gauge)",
     "legendFormat": "",
     "refId": "A",
     "editorMode": "code",
     "instant": true
