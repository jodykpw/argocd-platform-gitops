{
 "uid": "platform-velero",
 "title": "Velero (k8s-1)",
 "tags": [
  "platform",
  "velero",
  "backup"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Velero up",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min(up{job=\"velero\"})",
     "legendFormat": "",
     "refId": "A",
     "editorMode": "code",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Backup location",
   "description": "1 = the S3 bucket is reachable and the key accepted.",
