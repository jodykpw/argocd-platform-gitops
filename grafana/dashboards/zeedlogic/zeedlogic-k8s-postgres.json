{
  "uid": "bf06e401-3fd3-5ee6-ab59-d801409c7a3f",
  "templating": {
    "list": [
      {
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "zeedlogic-dev-pg",
          "value": "zeedlogic-dev-pg"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Database cluster",
        "multi": false,
        "name": "cluster",
        "options": [
          {
            "selected": true,
            "text": "zeedlogic-dev-pg",
            "value": "zeedlogic-dev-pg"
          },
          {
            "selected": false,
            "text": "jodywan-dev-pg",
            "value": "jodywan-dev-pg"
          }
        ],
        "query": "zeedlogic-dev-pg,jodywan-dev-pg",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "description": "Whether the Postgres exporter can reach the database (1) or not (0).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "cnpg_collector_up{job=\"databases/$cluster\"}",
          "refId": "A"
        }
      ],
      "title": "Postgres Up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "description": "Share of the database's connection slots in use.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * (sum(cnpg_backends_total{job=\"databases/$cluster\", datname=\"zeedlogic\"}) or vector(0)) / scalar(cnpg_pg_settings_setting{job=\"databases/$cluster\", name=\"max_connections\"})",
          "refId": "A"
        }
      ],
      "title": "Connections Used",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "description": "Share of reads served from memory rather than disk. Low values mean more disk reads.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * sum(cnpg_pg_stat_database_blks_hit{job=\"databases/$cluster\", datname=\"zeedlogic\"}) / (sum(cnpg_pg_stat_database_blks_hit{job=\"databases/$cluster\", datname=\"zeedlogic\"}) + sum(cnpg_pg_stat_database_blks_read{job=\"databases/$cluster\", datname=\"zeedlogic\"}))",
          "refId": "A"
        }
      ],
      "title": "Cache Hit Ratio",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "description": "Size of the zeedlogic database.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "cnpg_pg_database_size_bytes{job=\"databases/$cluster\", datname=\"zeedlogic\"}",
          "refId": "A"
        }
      ],
      "title": "Database Size",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "description": "Open connections to the zeedlogic database over time.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(cnpg_backends_total{job=\"databases/$cluster\", datname=\"zeedlogic\"}) by (state)",
          "refId": "A"
        }
      ],
      "title": "Active Connections",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "description": "Committed transactions per second.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(cnpg_pg_stat_database_xact_commit{job=\"databases/$cluster\", datname=\"zeedlogic\"}[5m])",
          "legendFormat": "commits",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(cnpg_pg_stat_database_xact_rollback{job=\"databases/$cluster\", datname=\"zeedlogic\"}[5m])",
          "legendFormat": "rollbacks",
          "refId": "B"
        }
      ],
      "title": "Transaction Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 7,
      "description": "Rows fetched per second.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(cnpg_pg_stat_database_tup_fetched{job=\"databases/$cluster\", datname=\"zeedlogic\"}[5m])",
          "legendFormat": "fetched",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(cnpg_pg_stat_database_tup_inserted{job=\"databases/$cluster\", datname=\"zeedlogic\"}[5m])",
          "legendFormat": "inserted",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(cnpg_pg_stat_database_tup_updated{job=\"databases/$cluster\", datname=\"zeedlogic\"}[5m])",
          "legendFormat": "updated",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(cnpg_pg_stat_database_tup_deleted{job=\"databases/$cluster\", datname=\"zeedlogic\"}[5m])",
          "legendFormat": "deleted",
          "refId": "D"
        }
      ],
      "title": "Row Operations",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 8,
      "description": "Deadlocks and conflicts per second. Any sustained value needs a look.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(cnpg_pg_stat_database_deadlocks{job=\"databases/$cluster\", datname=\"zeedlogic\"}[5m])",
          "legendFormat": "deadlocks",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(cnpg_pg_stat_database_conflicts{job=\"databases/$cluster\", datname=\"zeedlogic\"}[5m])",
          "legendFormat": "conflicts",
          "refId": "B"
        }
      ],
      "title": "Deadlocks & Conflicts",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "cloudnativepg",
    "kubernetes",
    "postgres",
    "prometheus",
    "zeedlogic"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "ZeedLogic Postgres (Kubernetes)",
  "version": 1
}
