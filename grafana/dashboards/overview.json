    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
